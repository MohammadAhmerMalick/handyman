# Public origin for canonical, hreflang, Open Graph, and JSON-LD (src/lib/siteUrl.ts).
#
# Local: copy to .env.local and use http://localhost:3000
# Docker/Contabo production: leave unset — defaults to beiruttobeirut.uroojperfumes.com
# Future handyman.ae cutover: https://handyman.ae
# Vercel preview: leave unset — VERCEL_URL is used automatically
#
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# NEXT_PUBLIC_GA_MEASUREMENT_ID=
# NEXT_PUBLIC_META_PIXEL_ID=
